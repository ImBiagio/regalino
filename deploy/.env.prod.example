# Modello del .env di produzione (~/regalino/.env sul server). I valori veri
# stanno nel vault, nota "Credenziali e accessi". Mai committare il .env.
DJANGO_SETTINGS_MODULE=config.settings.prod
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=regal.inoo.it,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://regal.inoo.it
FRONTEND_BASE_URL=https://regal.inoo.it

POSTGRES_DB=regalino
POSTGRES_USER=regalino
# openssl rand -hex 24
POSTGRES_PASSWORD=

REFRESH_COOKIE_SAMESITE=Lax
REQUIRE_EMAIL_VERIFICATION=1
# Codice d'invito (ADR 0018): se impostato ci si registra solo scrivendolo nel
# form. Senza, chiunque trovi il sito puo' creare un account.
# openssl rand -hex 8
# SIGNUP_CODE=
# SMTP di Brevo, lo stesso account di cinemino e soldino (dominio inoo.it
# autenticato). Login e SMTP key in Credenziali e accessi (vault di cinemino).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Regalino <messagg@inoo.it>

# DSN del progetto su GlitchTip (protocollo Sentry, ADR 0019): errori non
# gestiti di backend, worker, beat e scraper. Vuota: nessuna segnalazione.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

GUNICORN_WORKERS=3
LOG_LEVEL=INFO
