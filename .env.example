# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5176,http://localhost:8020

# --- Database ---
POSTGRES_DB=regalino
POSTGRES_USER=regalino
POSTGRES_PASSWORD=regalino
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis: cache Django (db 0) e coda Celery (db 1) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Auth ---
# Vita dei token JWT (secondi)
ACCESS_TOKEN_LIFETIME=900
REFRESH_TOKEN_LIFETIME=1209600
# In dev il cookie di refresh non e' Secure (niente https su localhost)
REFRESH_COOKIE_SECURE=0
REFRESH_COOKIE_SAMESITE=Lax
# Nome del cookie di refresh. I cookie ignorano la porta: soldino in locale
# usa soldino_refresh, qui serve un nome diverso.
REFRESH_COOKIE_NAME=regalino_refresh
# Verifica email obbligatoria alla registrazione
REQUIRE_EMAIL_VERIFICATION=0
# Codice d'invito (ADR 0018): se impostato ci si registra solo scrivendolo nel
# form. Vuoto o assente: registrazione aperta a tutti.
# SIGNUP_CODE=scegli-un-codice-lungo

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@regalino.local

# --- Link dei regali ---
# Chiave Gemini (Google AI Studio) per nome, prezzo e note presi dal link
# (ADR 0006). Vuota: si usano solo i dati che la pagina dichiara.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Errori ---
# DSN di GlitchTip (protocollo Sentry, ADR 0019) per backend, worker, beat e
# scraper. Vuota: nessuna segnalazione, l'SDK resta spento.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:5176
VITE_API_BASE_URL=http://localhost:8020
