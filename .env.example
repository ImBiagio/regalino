# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5176,http://localhost:8020

# --- Database ---
POSTGRES_DB=regalino
POSTGRES_USER=regalino
POSTGRES_PASSWORD=regalino
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis: cache Django (db 0) e coda Celery (db 1) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Auth ---
# Vita dei token JWT (secondi)
ACCESS_TOKEN_LIFETIME=900
REFRESH_TOKEN_LIFETIME=1209600
# In dev il cookie di refresh non e' Secure (niente https su localhost)
REFRESH_COOKIE_SECURE=0
REFRESH_COOKIE_SAMESITE=Lax
# Nome del cookie di refresh. I cookie ignorano la porta: soldino in locale
# usa soldino_refresh, qui serve un nome diverso.
REFRESH_COOKIE_NAME=regalino_refresh

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@regalino.local

# --- cornhub: login unico e AI (ADR 0020) ---
# In locale gira il compose di cornhub (http://localhost:8095, backend sulla
# 8096). Client e token: dal repo cornhub
#   docker compose exec backend python manage.py register_app regalino \
#     --name Regalino --url http://localhost:5176 --extra-redirect http://localhost:8020/api/auth/sso/callback
CORNHUB_URL=http://localhost:8095
CORNHUB_INTERNAL_URL=http://host.docker.internal:8096
CORNHUB_APP_SLUG=regalino
CORNHUB_CLIENT_ID=
CORNHUB_CLIENT_SECRET=
# Token del gateway AI (nome, prezzo e note dal link, Ispirami, import).
# Vuoto: AI spenta, si usano solo i dati che la pagina dichiara.
CORNHUB_APP_TOKEN=
# Il ritorno dal login di cornhub arriva all'API (in produzione = frontend).
API_PUBLIC_URL=http://localhost:8020

# --- Errori ---
# DSN di GlitchTip (protocollo Sentry, ADR 0019) per backend, worker, beat e
# scraper. Vuota: nessuna segnalazione, l'SDK resta spento.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# DSN del progetto GlitchTip del frontend (in produzione: variabile del repo
# SENTRY_DSN_FRONTEND, passata alla build dell'immagine web).
VITE_SENTRY_DSN=

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:5176
VITE_API_BASE_URL=http://localhost:8020
