msgid "Stato: %s. Tocca per passare a %s"
msgstr "Status: %s. Tap to switch to %s"

msgid "Elimina idea"
msgstr "Delete idea"

msgid "Eliminare l'idea?"
msgstr "Delete this idea?"

#, javascript-format
msgid "«%s» per %s."
msgstr "“%s” for %s."

msgid "Elimina"
msgstr "Delete"

msgid "Modifica idea"
msgstr "Edit idea"

msgid "Per chi"
msgstr "For whom"

msgid "Mamma, Luca, la collega…"
msgstr "Mum, Luke, a colleague…"

msgid "Cosa"
msgstr "What"

msgid "Occasione (facoltativa)"
msgstr "Occasion (optional)"

msgid "Natale, compleanno…"
msgstr "Christmas, birthday…"

msgid "Prezzo (facoltativo)"
msgstr "Price (optional)"

msgid "Scrivi un numero, es. 24,90"
msgstr "Enter a number, e.g. 24.90"

msgid "Link (facoltativo)"
msgstr "Link (optional)"

msgid "Note"
msgstr "Notes"

