#: apps/gifts/extension.py:72
msgid "Chiave dell'estensione non valida."
msgstr "Invalid extension key."

#: apps/gifts/extension.py:80
msgid "L'estensione e' stata scollegata: collegala di nuovo."
msgstr "The extension was disconnected: connect it again."

#: apps/gifts/extension.py:86
msgid "Il tuo account non puo' piu' usare Regalino: entra di nuovo dall'app."
msgstr "Your account can no longer use Regalino: sign in again from the app."

#: apps/gifts/images.py:63 apps/gifts/views.py:433
msgid "L'immagine e' troppo grande (massimo 10 MB)."
msgstr "The image is too large (10 MB max)."

#: apps/gifts/images.py:69
msgid "Il file non e' un'immagine che riesco a leggere."
msgstr "That file isn't an image I can read."

#: apps/gifts/images.py:97 apps/gifts/images.py:108
msgid "Non trovo il sito del link."
msgstr "I can't find the link's website."

#: apps/gifts/images.py:105
msgid "Questo link punta a un indirizzo non pubblico."
msgstr "This link points to a non-public address."

#: apps/gifts/images.py:123
msgid "Il link deve iniziare con http:// o https://."
msgstr "The link must start with http:// or https://."

#: apps/gifts/images.py:125
msgid "Il link non puo' contenere credenziali."
msgstr "The link can't contain credentials."

#: apps/gifts/images.py:128
msgid "Il link usa una porta non ammessa."
msgstr "The link uses a port that isn't allowed."

#: apps/gifts/images.py:156
msgid ""
"Il sito non si lascia leggere in automatico: carica la foto, oppure incolla "
"il link diretto dell'immagine (tasto destro sulla foto → Copia indirizzo "
"immagine)."
msgstr ""
"The site blocks automatic reading: upload the photo, or paste the direct "
"link of the image (right-click the photo → Copy image address)."

#: apps/gifts/images.py:163 apps/gifts/links.py:365
#, python-format
msgid "Il sito ha risposto con un errore (%s)."
msgstr "The site answered with an error (%s)."

#: apps/gifts/images.py:169
msgid "Il file del link e' troppo grande."
msgstr "The linked file is too large."

#: apps/gifts/images.py:175
msgid "Il sito non risponde."
msgstr "The site isn't responding."

#: apps/gifts/images.py:177 apps/gifts/images.py:188
msgid "Non riesco a leggere il link."
msgstr "I can't read the link."

#: apps/gifts/images.py:190
msgid "Il link rimanda troppe volte altrove."
msgstr "The link redirects too many times."

#: apps/gifts/imports.py:198
msgid "Il link non porta a una pagina web."
msgstr "The link doesn't lead to a web page."

#: apps/gifts/imports.py:205 apps/gifts/imports.py:214
#: apps/gifts/imports.py:216 apps/gifts/links.py:343 apps/gifts/links.py:345
#: apps/gifts/links.py:348
msgid "Non riesco ad aprire la pagina del link."
msgstr "I can't open the link's page."

#: apps/gifts/imports.py:221
msgid ""
"Il sito chiede di dimostrare di non essere un robot: apri la lista nel tuo "
"browser e importala con l'estensione di Regalino."
msgstr ""
"The site asks to prove you're not a robot: open the list in your browser and "
"import it with the Regalino extension."

#: apps/gifts/imports.py:415
msgid ""
"Non trovo regali in questa lista Amazon: controlla che sia pubblica o "
"condivisa col link."
msgstr ""
"I can't find any gifts in this Amazon list: check that it's public or shared "
"with the link."

#: apps/gifts/imports.py:420
msgid "Lista Amazon"
msgstr "Amazon list"

#: apps/gifts/imports.py:619
msgid ""
"Per leggere le liste di questo sito serve l'intelligenza artificiale, che "
"non e' configurata."
msgstr "Reading lists from this site needs AI, which isn't configured."

#: apps/gifts/imports.py:649
msgid "In questa pagina non trovo una lista di regali."
msgstr "I can't find a gift list on this page."

#: apps/gifts/imports.py:652 apps/gifts/imports.py:785
msgid "Lista importata"
msgstr "Imported list"

#: apps/gifts/imports.py:728
msgid "Il file JSON non e' valido."
msgstr "The JSON file isn't valid."

#: apps/gifts/imports.py:735
msgid "Il file JSON non contiene una lista di regali."
msgstr "The JSON file doesn't contain a gift list."

#: apps/gifts/imports.py:752
msgid "Nel CSV manca la colonna col nome del regalo (title, nome o titolo)."
msgstr "The CSV is missing the gift name column (title, nome or titolo)."

#: apps/gifts/imports.py:779
msgid "Il file e' troppo grande (al massimo 2 MB)."
msgstr "The file is too large (2 MB at most)."

#: apps/gifts/imports.py:792
msgid "Nel file non trovo regali."
msgstr "I can't find any gifts in the file."

#: apps/gifts/links.py:321
msgid "Il link non e' ne' un'immagine ne' una pagina web."
msgstr "The link is neither an image nor a web page."

#: apps/gifts/links.py:357
msgid ""
"Il sito chiede di dimostrare di non essere un robot: carica la foto, oppure "
"incolla il link diretto dell'immagine (tasto destro sulla foto → Copia "
"indirizzo immagine)."
msgstr ""
"The site asks to prove you're not a robot: upload the photo, or paste the "
"direct link of the image (right-click the photo → Copy image address)."

#: apps/gifts/links.py:442
msgid ""
"In quella pagina non trovo un'immagine del prodotto: caricala tu dal "
"telefono."
msgstr "I can't find a product image on that page: upload one from your phone."

#: apps/gifts/models.py:281
msgid "Idea"
msgstr "Idea"

#: apps/gifts/models.py:282
msgid "Comprato"
msgstr "Bought"

#: apps/gifts/models.py:283
msgid "Regalato"
msgstr "Given"

#: apps/gifts/prices.py:91
#, python-format
msgid "È sceso: %(title)s"
msgstr "Price drop: %(title)s"

#: apps/gifts/prices.py:92
#, python-format
msgid "Da %(before)s a %(after)s (-%(drop)s%%)"
msgstr "From %(before)s to %(after)s (-%(drop)s%%)"

#: apps/gifts/prices.py:105
#, python-format
msgid "Avevi messo la campanella su «%(title)s»."
msgstr "You put the bell on “%(title)s”."

#: apps/gifts/prices.py:107
msgid "Apri"
msgstr "Open"

#: apps/gifts/prices.py:109
msgid "Prezzo letto dal link del negozio: puo' cambiare ancora."
msgstr "Price read from the shop link: it may change again."

#: apps/gifts/serializers.py:25
msgid "Il prezzo non puo' essere negativo."
msgstr "The price can't be negative."

#: apps/gifts/serializers.py:238
msgid "Scegli un regalo di questa lista."
msgstr "Pick a gift from this list."

#: apps/gifts/serializers.py:241
msgid "Un regalo non puo' andare con se stesso."
msgstr "A gift can't go with itself."

#: apps/gifts/serializers.py:248
#, python-format
msgid "«%(title)s» va gia' con questo regalo: sarebbe un giro."
msgstr "“%(title)s” already goes with this gift: that would be a loop."

#: apps/gifts/serializers.py:372
msgid "Una lista non puo' includere se stessa."
msgstr "A list can't include itself."

#: apps/gifts/serializers.py:377
msgid ""
"Questa lista e' gia' dentro un'altra: non puo' includerne altre a sua volta."
msgstr ""
"This list already sits inside another one: it can't include lists in turn."

#: apps/gifts/serializers.py:382
msgid "Una delle liste non esiste piu'."
msgstr "One of the lists no longer exists."

#: apps/gifts/serializers.py:385
#, python-format
msgid "«%(title)s» include gia' altre liste: una inclusa non ne include."
msgstr ""
"“%(title)s” already includes other lists: an included list can't include any."

#: apps/gifts/serializers.py:452
msgid "Scrivi per chi e' il regalo."
msgstr "Write who the gift is for."

#: apps/gifts/serializers.py:707
#, python-format
msgid "Per %(name)s"
msgstr "For %(name)s"

#: apps/gifts/serializers.py:711
#, python-format
msgid "%(list)s di %(owner)s"
msgstr "%(list)s by %(owner)s"

#: apps/gifts/serializers.py:759
msgid "Incolla un link oppure scegli un file."
msgstr "Paste a link or choose a file."

#: apps/gifts/serializers.py:787
msgid "Troppi livelli di liste."
msgstr "Too many levels of lists."

#: apps/gifts/serializers.py:802
msgid "Scegli almeno una lista da importare."
msgstr "Choose at least one list to import."

#: apps/gifts/views.py:101
msgid "Solo chi ha creato la lista puo' farlo."
msgstr "Only whoever created the list can do that."

#: apps/gifts/views.py:204
msgid "Attiva \"Mostrami cosa e' stato regalato\" per gestire le spunte."
msgstr "Turn on \"Show me what has been given\" to manage the ticks."

#: apps/gifts/views.py:258
msgid "I suggerimenti non sono attivi su questo server."
msgstr "Suggestions are not enabled on this server."

#: apps/gifts/views.py:486
msgid "In quella pagina non trovo il prodotto."
msgstr "I can't find the product on that page."

#: apps/gifts/views.py:579
msgid "Non sono riuscito a leggere la lista."
msgstr "I couldn't read the list."

#: apps/gifts/views.py:692
msgid "È una lista che scrivi tu: la trovi già in «Le mie liste»."
msgstr "You write this list: it is already in “My lists”."

#: apps/gifts/views.py:803
msgid "Non puoi spuntare i regali della tua lista."
msgstr "You can't tick the gifts on your own list."

#: apps/gifts/views.py:808
msgid "Qualcuno l'ha appena regalato: ricarica la lista."
msgstr "Someone has just taken it: reload the list."

#: apps/gifts/views.py:814
#, python-format
msgid "Va con «%(title)s»: prima serve che qualcuno regali quello."
msgstr "It goes with “%(title)s”: someone needs to give that one first."

#: apps/gifts/views.py:858
msgid "Solo chi l'ha spuntato puo' togliere la spunta."
msgstr "Only whoever ticked it can untick it."

#: apps/users/views.py:91
msgid "Sessione assente."
msgstr "No session."

#: apps/users/views.py:95
msgid "Sessione scaduta."
msgstr "Session expired."

#: apps/users/views.py:102
msgid "Accesso non piu' valido."
msgstr "Access no longer valid."

#: templates/emails/base.html:25 templates/emails/base.txt:1
#, python-format
msgid "Ciao %(name)s,"
msgstr "Hi %(name)s,"

#: templates/emails/base.html:37
msgid "Se il bottone non funziona, copia questo link nel browser:"
msgstr "If the button doesn't work, copy this link into your browser:"
