#: apps/gifts/images.py:63 apps/gifts/views.py:292
msgid "L'immagine e' troppo grande (massimo 10 MB)."
msgstr "The image is too large (10 MB max)."

#: apps/gifts/images.py:69
msgid "Il file non e' un'immagine che riesco a leggere."
msgstr "That file isn't an image I can read."

#: apps/gifts/images.py:97 apps/gifts/images.py:108
msgid "Non trovo il sito del link."
msgstr "I can't find the link's website."

#: apps/gifts/images.py:105
msgid "Questo link punta a un indirizzo non pubblico."
msgstr "This link points to a non-public address."

#: apps/gifts/images.py:123
msgid "Il link deve iniziare con http:// o https://."
msgstr "The link must start with http:// or https://."

#: apps/gifts/images.py:125
msgid "Il link non puo' contenere credenziali."
msgstr "The link can't contain credentials."

#: apps/gifts/images.py:128
msgid "Il link usa una porta non ammessa."
msgstr "The link uses a port that isn't allowed."

#: apps/gifts/images.py:156
msgid ""
"Il sito non si lascia leggere in automatico: carica la foto, oppure incolla "
"il link diretto dell'immagine (tasto destro sulla foto → Copia indirizzo "
"immagine)."
msgstr ""
"The site blocks automatic reading: upload the photo, or paste the direct "
"link of the image (right-click the photo → Copy image address)."

#: apps/gifts/images.py:163 apps/gifts/links.py:355
#, python-format
msgid "Il sito ha risposto con un errore (%s)."
msgstr "The site answered with an error (%s)."

#: apps/gifts/images.py:169
msgid "Il file del link e' troppo grande."
msgstr "The linked file is too large."

#: apps/gifts/images.py:175
msgid "Il sito non risponde."
msgstr "The site isn't responding."

#: apps/gifts/images.py:177 apps/gifts/images.py:188
msgid "Non riesco a leggere il link."
msgstr "I can't read the link."

#: apps/gifts/images.py:190
msgid "Il link rimanda troppe volte altrove."
msgstr "The link redirects too many times."

#: apps/gifts/links.py:311
msgid "Il link non e' ne' un'immagine ne' una pagina web."
msgstr "The link is neither an image nor a web page."

#: apps/gifts/links.py:333 apps/gifts/links.py:335 apps/gifts/links.py:338
msgid "Non riesco ad aprire la pagina del link."
msgstr "I can't open the link's page."

#: apps/gifts/links.py:347
msgid ""
"Il sito chiede di dimostrare di non essere un robot: carica la foto, oppure "
"incolla il link diretto dell'immagine (tasto destro sulla foto → Copia "
"indirizzo immagine)."
msgstr ""
"The site asks to prove you're not a robot: upload the photo, or paste the "
"direct link of the image (right-click the photo → Copy image address)."

#: apps/gifts/links.py:432
msgid ""
"In quella pagina non trovo un'immagine del prodotto: caricala tu dal "
"telefono."
msgstr "I can't find a product image on that page: upload one from your phone."

#: apps/gifts/models.py:232
msgid "Idea"
msgstr "Idea"

#: apps/gifts/models.py:233
msgid "Comprato"
msgstr "Bought"

#: apps/gifts/models.py:234
msgid "Regalato"
msgstr "Given"

#: apps/gifts/serializers.py:14
msgid "Il prezzo non puo' essere negativo."
msgstr "The price can't be negative."

#: apps/gifts/serializers.py:178
msgid "Scegli un regalo di questa lista."
msgstr "Pick a gift from this list."

#: apps/gifts/serializers.py:181
msgid "Un regalo non puo' andare con se stesso."
msgstr "A gift can't go with itself."

#: apps/gifts/serializers.py:188
#, python-format
msgid "«%(title)s» va gia' con questo regalo: sarebbe un giro."
msgstr "“%(title)s” already goes with this gift: that would be a loop."

#: apps/gifts/serializers.py:312
msgid "Una lista non puo' includere se stessa."
msgstr "A list can't include itself."

#: apps/gifts/serializers.py:317
msgid ""
"Questa lista e' gia' dentro un'altra: non puo' includerne altre a sua volta."
msgstr ""
"This list already sits inside another one: it can't include lists in turn."

#: apps/gifts/serializers.py:322
msgid "Una delle liste non esiste piu'."
msgstr "One of the lists no longer exists."

#: apps/gifts/serializers.py:325
#, python-format
msgid "«%(title)s» include gia' altre liste: una inclusa non ne include."
msgstr ""
"“%(title)s” already includes other lists: an included list can't include any."

#: apps/gifts/serializers.py:390
msgid "Scrivi per chi e' il regalo."
msgstr "Write who the gift is for."

#: apps/gifts/views.py:82
msgid "Solo chi ha creato la lista puo' farlo."
msgstr "Only whoever created the list can do that."

#: apps/gifts/views.py:173
msgid "Attiva \"Mostrami cosa e' stato regalato\" per gestire le spunte."
msgstr "Turn on \"Show me what has been given\" to manage the ticks."

#: apps/gifts/views.py:211
msgid "I suggerimenti non sono attivi su questo server."
msgstr "Suggestions are not enabled on this server."

#: apps/gifts/views.py:230
msgid "Adesso non riesco a trovare idee: riprova tra un momento."
msgstr "I can't find ideas right now: try again in a moment."

#: apps/gifts/views.py:345
msgid "In quella pagina non trovo il prodotto."
msgstr "I can't find the product on that page."

#: apps/gifts/views.py:486
msgid "Non puoi spuntare i regali della tua lista."
msgstr "You can't tick the gifts on your own list."

#: apps/gifts/views.py:491
msgid "Qualcuno l'ha appena regalato: ricarica la lista."
msgstr "Someone has just taken it: reload the list."

#: apps/gifts/views.py:497
#, python-format
msgid "Va con «%(title)s»: prima serve che qualcuno regali quello."
msgstr "It goes with “%(title)s”: someone needs to give that one first."

#: apps/gifts/views.py:541
msgid "Solo chi l'ha spuntato puo' togliere la spunta."
msgstr "Only whoever ticked it can untick it."

#: apps/users/emails.py:21
msgid "Conferma il tuo indirizzo email"
msgstr "Confirm your email address"

#: apps/users/emails.py:24
msgid ""
"Manca un passo: conferma che questo indirizzo e' tuo e il tuo account "
"Regalino e' pronto."
msgstr ""
"One last step: confirm this address is yours and your Regalino account is "
"ready."

#: apps/users/emails.py:27
msgid "Conferma email"
msgstr "Confirm email"

#: apps/users/emails.py:30
msgid ""
"Il link vale 3 giorni e una volta sola. Se non ti sei registrato tu, ignora "
"questa mail."
msgstr ""
"The link is valid for 3 days and can be used once. If you didn't sign up, "
"just ignore this email."

#: apps/users/emails.py:40
msgid "Reimposta la password di Regalino"
msgstr "Reset your Regalino password"

#: apps/users/emails.py:43
msgid ""
"Qualcuno (speriamo tu) ha chiesto di reimpostare la password del tuo account "
"Regalino."
msgstr ""
"Someone (hopefully you) asked to reset the password of your Regalino account."

#: apps/users/emails.py:46
msgid "Scegli una nuova password"
msgstr "Choose a new password"

#: apps/users/emails.py:49
msgid ""
"Il link vale 2 ore e una volta sola. Se non l'hai chiesto tu, ignora questa "
"mail: la password resta quella di prima."
msgstr ""
"The link is valid for 2 hours and can be used once. If you didn't request "
"it, just ignore this email: your password stays the same."

#: apps/users/serializers.py:45
msgid "Esiste gia' un account con questa email."
msgstr "An account with this email already exists."

#: apps/users/views.py:74
msgid "Registrazione completata. Controlla la mail per confermare."
msgstr "Sign-up complete. Check your email to confirm."

#: apps/users/views.py:100
msgid "Credenziali non valide."
msgstr "Invalid credentials."

#: apps/users/views.py:105
msgid "Email non ancora confermata."
msgstr "Email not confirmed yet."

#: apps/users/views.py:121
msgid "Refresh token assente."
msgstr "Refresh token missing."

#: apps/users/views.py:127
msgid "Refresh token non valido."
msgstr "Invalid refresh token."

#: apps/users/views.py:133
msgid "Utente non valido."
msgstr "Invalid user."

#: apps/users/views.py:170
msgid "Link non valido o scaduto."
msgstr "Invalid or expired link."

#: apps/users/views.py:175
msgid "Utente inesistente."
msgstr "User doesn't exist."

#: apps/users/views.py:180
msgid "Email gia' confermata: accedi con la tua password."
msgstr "Email already confirmed: sign in with your password."

#: apps/users/views.py:212
msgid "Password attuale errata."
msgstr "Current password is incorrect."

#: apps/users/views.py:274
msgid "Link non valido, gia' usato o scaduto: chiedine uno nuovo."
msgstr "Invalid, already used or expired link: request a new one."

#: templates/emails/base.html:25 templates/emails/base.txt:1
#, python-format
msgid "Ciao %(name)s,"
msgstr "Hi %(name)s,"

#: templates/emails/base.html:37
msgid "Se il bottone non funziona, copia questo link nel browser:"
msgstr "If the button doesn't work, copy this link into your browser:"
